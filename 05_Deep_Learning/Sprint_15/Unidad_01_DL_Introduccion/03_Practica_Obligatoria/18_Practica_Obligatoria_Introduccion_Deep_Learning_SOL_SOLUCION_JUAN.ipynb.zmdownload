  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Random Forest"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "¿Cuántos modelos vamos a entrenar con el GridSearch? 1441\n"
     ]
    }
   ],
   "source": [
    "print(\"¿Cuántos modelos vamos a entrenar con el GridSearch?\", 480 * 3 + 1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Vamos a probar 480 combinaciones de hiperparámetros\n"
     ]
    }
   ],
   "source": [
    "\n",
    "parameter_space = {\n",
    "    'modelo__n_estimators': [100, 200, 400], \n",
    "    'modelo__max_depth': [None,2,4,10],\n",
    "    'modelo__min_samples_leaf': [1,5,10,20,40],\n",
    "    'modelo__max_features': [\"sqrt\",\"log2\", len(X_train.columns)//2, None],\n",
    "    \"modelo__class_weight\": [None,\"balanced\"]\n",
    "}\n",
    "\n",
    "num_experiments = np.prod([len(rangos) for rangos in parameter_space.values()])\n",
    "print(f\"Vamos a probar {num_experiments} combinaciones de hiperparámetros\")\n",
    "\n",
    "clf = GridSearchCV(rf_clf, \n",
    "                   parameter_space, \n",
    "                   cv=3,\n",
    "                   scoring = \"balanced_accuracy\")\n"
   ]
  },
